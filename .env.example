# vcv-rack-mcp - copy to .env and fill in (never commit .env)
# VCV Rack 2 install location
RACK_EXE=C:\Program Files\VCV\Rack2Free\Rack.exe
# Rack user dir (plugins/ scanned by vcv_catalog verify_installed)
RACK_USER_DIR=%LOCALAPPDATA%\Rack2Free
# Server bind
HOST=127.0.0.1
PORT=10916
# Downstream osc-mcp for live control (vcv_manager consumes address maps)
OSC_MCP_BASE=http://127.0.0.1:10767
